generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Project {
  id          String   @id @default(uuid())
  title       String
  type        String
  year        String
  description String
  images      String[]
  stacks      String[]
  features    String[]
  whatsInside String?
  howItsBuilt String?
  whyIBuiltIt String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model HeroContent {
  id          Int    @id @default(1)
  greeting    String
  description String
}

model Journey {
  id          String   @id @default(uuid())
  year        String
  title       String
  description String
  status      String
  type        String
  tech        String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Education {
  id          String   @id @default(uuid())
  period      String
  degree      String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Experience {
  id         String   @id @default(uuid())
  title      String
  period     String
  company    String
  isLatest   Boolean  @default(false)
  highlights String[]
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Skill {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)
}

model Certification {
  id        String   @id @default(uuid())
  title     String
  provider  String
  year      String
  logoText  String
  verifyUrl String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model SocialLink {
  id    String @id @default(uuid())
  name  String
  url   String
  order Int    @default(0)
}

model ContentSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}